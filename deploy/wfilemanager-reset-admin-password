#!/usr/bin/env bash
set -Eeuo pipefail

[[ "${EUID:-$(id -u)}" -eq 0 ]] || { echo "Run this command as root." >&2; exit 1; }
[[ $# -eq 0 ]] || { echo "Usage: sudo wfilemanager-reset-admin-password" >&2; exit 2; }

ENV_FILE="${WFILEMANAGER_ENV_FILE:-/etc/wfilemanager/wfilemanager.env}"
[[ -f "$ENV_FILE" ]] || { echo "Missing $ENV_FILE" >&2; exit 1; }

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

read -rsp "New administrator password: " NEW_PASSWORD
echo
read -rsp "Confirm new password: " CONFIRM_PASSWORD
echo
[[ "$NEW_PASSWORD" == "$CONFIRM_PASSWORD" ]] || { echo "Passwords do not match." >&2; exit 1; }

cleanup() {
  unset NEW_PASSWORD CONFIRM_PASSWORD WFM_PASSWORD
}
trap cleanup EXIT

DB_PATH="${WFILEMANAGER_SQLITE_PATH:-/var/lib/wfilemanager/wfilemanager.db}"
[[ -f "$DB_PATH" ]] || { echo "SQLite database was not found at $DB_PATH" >&2; exit 1; }

WFM_DB_PATH="$DB_PATH" WFM_PASSWORD="$NEW_PASSWORD" node --input-type=module <<'NODE'
import { randomBytes, scryptSync } from "node:crypto";
import { DatabaseSync } from "node:sqlite";

const password = process.env.WFM_PASSWORD || "";
let policyError = "";
if (password.length < 12) policyError = "Password must contain at least 12 characters.";
else if (!/^[A-Za-z0-9]+$/.test(password)) policyError = "Password may contain only uppercase letters, lowercase letters and numbers.";
else if (!/[A-Z]/.test(password)) policyError = "Password must contain an uppercase letter.";
else if (!/[a-z]/.test(password)) policyError = "Password must contain a lowercase letter.";
else if (!/[0-9]/.test(password)) policyError = "Password must contain a number.";
else if (/(.)\1/.test(password)) policyError = "Password must not contain identical consecutive characters.";
if (policyError) {
  console.error(policyError);
  process.exit(1);
}

const db = new DatabaseSync(process.env.WFM_DB_PATH);
const table = db.prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name='wfm_users'").get();
if (!table) {
  console.error("Start wFileManager once to migrate the database, then rerun this command.");
  process.exit(2);
}
const admin = db.prepare("SELECT id FROM wfm_users WHERE id = 'admin' AND is_admin = 1").get();
if (!admin) {
  console.error("No administrator exists. Open /setup first.");
  process.exit(2);
}

const salt = randomBytes(16).toString("hex");
const hash = scryptSync(password, Buffer.from(salt, "hex"), 64).toString("hex");
const now = new Date().toISOString();
db.exec("BEGIN IMMEDIATE");
try {
  db.prepare("UPDATE wfm_users SET password_hash = ?, password_salt = ?, status = 'active', updated_at = ? WHERE id = 'admin'")
    .run(hash, salt, now);
  db.prepare("DELETE FROM wfm_sessions WHERE user_id = 'admin'").run();
  db.exec("COMMIT");
} catch (error) {
  db.exec("ROLLBACK");
  throw error;
}
console.log("Administrator password reset completed.");
console.log("All administrator sessions were revoked.");
NODE
