#!/usr/bin/env bash
set -Eeuo pipefail
STATE_ROOT=/var/lib/wfilemanager
RESTORE_ROOT=/var/lib/wfilemanager/restores
STAGING_ROOT=/var/lib/wfilemanager/backup-staging
MAX_FILE_BYTES=21474836480
KEY_FILE=/etc/wfilemanager/backup-transfer.key
mkdir -p "$STAGING_ROOT" "$RESTORE_ROOT"
chmod 700 "$STAGING_ROOT" "$RESTORE_ROOT"
fail() { printf '%s\n' "$1" >&2; exit 1; }
require_key() {
  [[ -f "$KEY_FILE" && ! -L "$KEY_FILE" ]] || fail "Missing backup transfer key"
  [[ "$(stat -c %a "$KEY_FILE")" -le 600 ]] || fail "Backup transfer key permissions are unsafe"
}
safe_source() {
  local source="$1"
  [[ "$source" == /* && "$source" != / && -d "$source" ]] || fail "Backup source must be an existing non-root directory"
  [[ "$source" != /proc/* && "$source" != /sys/* && "$source" != /dev/* && "$source" != /run/* && "$source" != /boot/* ]] || fail "Protected system path"
  [[ ! -L "$source" ]] || fail "Symbolic-link sources are not supported"
  while IFS= read -r -d '' file; do
    [[ ! -L "$file" ]] || fail "Symbolic links are not supported"
    (( $(stat -c %s -- "$file") <= MAX_FILE_BYTES )) || fail "A file exceeds the 20 GiB limit"
  done < <(find -P "$source" -xdev -type f -print0)
}
archive() {
  local source="$1" job="$2" output="$STAGING_ROOT/$job.tar.gz"
  safe_source "$source"; umask 077
  tar --create --gzip --file "$output" --directory "$(dirname "$source")" -- "$(basename "$source")"
  printf '%s\n' "$output"
}
upload() {
  local source="$1" job="$2" signed_url="$3" archive_file encrypted
  [[ "$signed_url" == https://* ]] || fail "A HTTPS signed upload URL is required"
  require_key; archive_file="$(archive "$source" "$job")"; encrypted="$STAGING_ROOT/$job.tar.gz.enc"
  openssl enc -aes-256-cbc -pbkdf2 -iter 210000 -salt -in "$archive_file" -out "$encrypted" -pass file:"$KEY_FILE"
  curl --fail --silent --show-error --retry 3 --retry-all-errors --upload-file "$encrypted" "$signed_url"
  sha256sum "$encrypted" | awk '{print $1}'
}
restore() {
  local job="$1" signed_url="$2" encrypted archive_file target
  [[ "$signed_url" == https://* ]] || fail "A HTTPS signed download URL is required"
  require_key; target="$RESTORE_ROOT/$job"; encrypted="$STAGING_ROOT/$job.restore.enc"; archive_file="$STAGING_ROOT/$job.restore.tar.gz"
  [[ ! -e "$target" ]] || fail "Restore destination already exists"
  mkdir -p "$target"; chmod 700 "$target"
  curl --fail --silent --show-error --retry 3 --retry-all-errors --output "$encrypted" "$signed_url"
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 210000 -in "$encrypted" -out "$archive_file" -pass file:"$KEY_FILE"
  tar -tzf "$archive_file" | grep -Eq '(^/|(^|/)\.\.(/|$))' && fail "Unsafe archive path"
  tar --extract --gzip --file "$archive_file" --directory "$target" --no-same-owner --no-same-permissions
  printf '%s\n' "$target"
}
case "$1" in
 validate) safe_source "$2" ;;
 archive) archive "$2" "$3" ;;
 upload) upload "$2" "$3" "$4" ;;
 restore) restore "$2" "$3" ;;
 restore-root) printf '%s\n' "$RESTORE_ROOT" ;;
 *) fail "Usage: worker validate|archive|upload|restore|restore-root" ;;
esac
