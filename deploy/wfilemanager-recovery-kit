#!/usr/bin/env bash
set -Eeuo pipefail

ENV_FILE="${WFILEMANAGER_ENV_FILE:-/etc/wfilemanager/wfilemanager.env}"
RECOVERY_KEY_FILE="${WFILEMANAGER_RECOVERY_KEY_FILE:-/etc/wfilemanager/root-reset.key}"
ACTION="${1:-show}"
DESTINATION="${2:-/root/wfilemanager-recovery-kit.txt}"
TERMS_URL="${WFILEMANAGER_TERMS_URL:-https://wfilemanager.kmerhosting.com/terms}"

[[ $EUID -eq 0 ]] || { echo "Run this command with sudo or as root." >&2; exit 1; }
[[ -f "$ENV_FILE" ]] || { echo "wFileManager configuration was not found." >&2; exit 1; }
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

[[ "${WFILEMANAGER_DATABASE_MODE:-}" == "supabase" ]] || {
  echo "A Recovery Kit is only used by the Pro managed application-data plan." >&2
  exit 1
}
[[ -s "$RECOVERY_KEY_FILE" ]] || { echo "The recovery key file is missing." >&2; exit 1; }

RECOVERY_KEY="$(tr -d '\r\n' <"$RECOVERY_KEY_FILE")"
INSTANCE_KEY="${WFILEMANAGER_INSTANCE_KEY:-}"
DOMAIN="${WFILEMANAGER_DOMAIN:-}"

render() {
  cat <<TEXT
wFileManager Recovery Kit

Instance key: $INSTANCE_KEY
Recovery key: $RECOVERY_KEY
Domain: $DOMAIN
Application-data plan: Pro — managed application data
Terms of Use: $TERMS_URL

Keep this file outside the server. It can recover the managed application data after the server is reinstalled or lost. Recovery rotates this key,
so replace every old copy after a successful recovery.

Pro billing lifecycle:
- A valid server heartbeat keeps the instance marked online.
- Missing heartbeats do not delete paid Pro managed application data.
- If Pro payment is more than 7 days overdue, the managed account may be suspended and sessions revoked.
- If Pro payment is more than 30 days overdue, the managed application data and remote instance account may be permanently deleted.

Uninstall policy:
- Local-only uninstall removes the server installation and keeps the Pro managed application data and subscription for recovery.
- Permanent Pro deletion removes the remote managed application data and instance account, then removes the local installation.
- Pro managed data covers only wFileManager users, roles, sessions, authentication records, notifications, settings, backups and recovery metadata.
- Server filesystem files, websites, databases, uploads, directories and mounted volumes require a separate backup policy.

To recover or delete the remote data, run the official installer or sudo wfilemanager-uninstall and choose the corresponding Pro action.
TEXT
}

case "$ACTION" in
  show)
    render
    ;;
  export)
    umask 077
    render >"$DESTINATION"
    chmod 600 "$DESTINATION"
    echo "$DESTINATION"
    ;;
  *)
    echo "Usage: $0 {show|export [destination]}" >&2
    exit 64
    ;;
esac
